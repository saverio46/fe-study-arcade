{
  "_meta": {
    "purpose": "Generic, topic-agnostic data schemas for procedurally generating each puzzle type. Field names are deliberately abstract (items, answer, clue, categories, attributes) so any dataset — FE exam terms, vocabulary, trivia, formulas — can be mapped into these shapes to auto-generate a puzzle. Full mechanics, generation algorithms, and edge cases for each type live in puzzle-engine-reference.html.",
    "categories": ["Word & Language", "Grid & Spatial Logic", "Deduction & Social", "Math & Physical"]
  },
  "puzzles": [
    {
      "slug": "word-search",
      "name": "Word Search",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [{ "answer": "TERM1" }, { "answer": "TERM2" }, { "answer": "TERM3" }],
        "config": {
          "rows": 15, "cols": 15,
          "directions": ["E", "W", "N", "S", "NE", "NW", "SE", "SW"],
          "allow_backwards": true, "allow_overlap": true,
          "max_placement_attempts": 200
        }
      }
    },
    {
      "slug": "crossword",
      "name": "Crossword",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [
          { "answer": "TERM1", "clue": "clue1" },
          { "answer": "TERM2", "clue": "clue2" },
          { "answer": "TERM3", "clue": "clue3" }
        ],
        "config": { "max_rows": 15, "max_cols": 15, "enforce_symmetry": false, "min_word_length": 3 }
      }
    },
    {
      "slug": "wordle",
      "name": "Wordle",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [{ "answer": "term1" }],
        "config": {
          "word_length": 5, "max_guesses": 6,
          "guess_dictionary": ["term1", "otherword1", "otherword2"]
        }
      }
    },
    {
      "slug": "word-snake",
      "name": "Word Snake",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [
          { "answer": "term1", "clue": "clue1" },
          { "answer": "termB", "clue": "clueB" },
          { "answer": "beta", "clue": "clueC" }
        ],
        "config": { "min_chain_length": 5, "grid_width": 12 }
      }
    },
    {
      "slug": "anagram",
      "name": "Anagram",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [{ "answer": "term1", "clue": "clue1" }],
        "config": { "min_length": 4, "allow_multi_word": false }
      }
    },
    {
      "slug": "cryptogram",
      "name": "Cryptogram",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [{ "text": "quote or fact text here", "source": "attribution (optional)" }],
        "config": { "reveal_count": 2 }
      }
    },
    {
      "slug": "inner-outer-word",
      "name": "Inner/Outer Word",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [{ "outer": "term1", "outer_clue": "clue1" }],
        "config": { "min_inner_length": 3, "max_hits_per_outer": 1 }
      }
    },
    {
      "slug": "same-word-fill-in-the-blank",
      "name": "Same-word Fill-in-the-Blank",
      "category": "Word & Language",
      "dataTemplate": {
        "items": [
          {
            "answer": "term1",
            "sentences": [
              "sentence1 with a _____ in it",
              "a different sentence2 also needing _____",
              "sentence3, unrelated context, still needs _____"
            ]
          }
        ],
        "config": { "blank_marker": "_____" }
      }
    },
    {
      "slug": "sudoku",
      "name": "Sudoku",
      "category": "Grid & Spatial Logic",
      "dataTemplate": {
        "puzzleType": "sudoku",
        "gridSize": 9,
        "boxDims": [3, 3],
        "symbolSet": ["itemA", "itemB", "itemC", "itemD", "itemE", "itemF", "itemG", "itemH", "itemI"],
        "generationParams": { "givenCount": 30, "symmetry": "rotational180", "targetDifficulty": "medium" },
        "revealOverlay": { "cells": [[0, 0], [0, 1], [0, 2]], "onCompleteFact": "attributeA relates to attributeB because ..." }
      }
    },
    {
      "slug": "nonogram",
      "name": "Nonogram",
      "category": "Grid & Spatial Logic",
      "dataTemplate": {
        "puzzleType": "nonogram",
        "gridSize": { "rows": 10, "cols": 10 },
        "source": { "mode": "textRender", "revealText": "TERMA", "font": "pixel5x7" },
        "sourceAlt": {
          "mode": "dataMatrix",
          "items": ["itemA", "itemB", "itemC"],
          "attributes": ["attr1", "attr2", "attr3"],
          "matrix": [[1, 0, 1], [0, 1, 0], [1, 1, 0]]
        },
        "palette": ["#000000"]
      }
    },
    {
      "slug": "minesweeper",
      "name": "Minesweeper",
