      "difficulty": "medium",
      "stem": "What is dy/dx for x²ye²ˣ = sin y?",
      "choices": {
        "A": "2e²ˣ/(x²−cos y)",
        "B": "(2e²ˣ−2xy)/(x²−cos y)",
        "C": "(2e²ˣ−2xy)/(x²−cos y)",
        "D": "(x²−cos y)/(2e²ˣ−2xy)"
