  "questions": [
    {
      "id": "MATH-D7-Q1",
      "subtopic": "Calculus",
      "difficulty": "medium",
      "stem": "Evaluate the definite integral of f(x) = 3x^2 from x = 1 to x = 2.",
      "choices": {
        "A": "3",
        "B": "5",
        "C": "7",
        "D": "9"
      },
      "correct_answer": "C",
      "explanation": "The antiderivative of 3x^2 is x^3. Evaluating from 1 to 2 gives 2^3 - 1^3 = 8 - 1 = 7.",
      "reference": "FE Reference Handbook, Mathematics: Calculus"
    },
    {
      "id": "MATH-D7-Q2",
      "subtopic": "Calculus",
      "difficulty": "easy",
      "stem": "Evaluate the limit: lim (x → 2) (x^2 - 4) / (x - 2).",
      "choices": {
        "A": "0",
        "B": "2",
        "C": "4",
        "D": "undefined"
      },
      "correct_answer": "C",
      "explanation": "Factoring the numerator gives (x-2)(x+2). The (x-2) terms cancel, leaving lim (x → 2) (x + 2) = 4.",
      "reference": "FE Reference Handbook, Mathematics: Calculus"
    },
    {
      "id": "MATH-D7-Q3",
      "subtopic": "Calculus",
      "difficulty": "medium",
      "stem": "If f(x) = x^3 - 2x, what is the value of the first derivative f'(x) at x = 2?",
      "choices": {
        "A": "4",
        "B": "8",
        "C": "10",
        "D": "12"
      },
      "correct_answer": "C",
      "explanation": "The first derivative is f'(x) = 3x^2 - 2. Substituting x = 2 gives 3(2)^2 - 2 = 12 - 2 = 10.",
      "reference": "FE Reference Handbook, Mathematics: Calculus"
    },
    {
      "id": "MATH-D7-Q4",
      "subtopic": "Calculus",
      "difficulty": "medium",
      "stem": "Find the value of x that minimizes the function f(x) = x^2 - 6x + 10.",
      "choices": {
        "A": "2",
        "B": "3",
        "C": "4",
        "D": "6"
      },
      "correct_answer": "B",
      "explanation": "Take the derivative and set it to zero to find critical points: f'(x) = 2x - 6 = 0, which yields x = 3. Since the second derivative is positive (2 > 0), this is a minimum.",
      "reference": "FE Reference Handbook, Mathematics: Calculus"
    },
    {
      "id": "MATH-D7-Q5",
      "subtopic": "Calculus",
      "difficulty": "easy",
      "stem": "Evaluate the definite integral of f(x) = 2x + 1 from x = 0 to x = 3.",
      "choices": {
        "A": "10",
        "B": "12",
        "C": "14",
        "D": "16"
      },
      "correct_answer": "B",
      "explanation": "The antiderivative is x^2 + x. Evaluating from 0 to 3 gives (3^2 + 3) - (0 + 0) = 9 + 3 = 12.",
      "reference": "FE Reference Handbook, Mathematics: Calculus"
    },
    {
      "id": "MATH-CALC-EXTRA-6",
      "subtopic": "Calculus",
      "difficulty": "medium",
      "stem": "∫(x³ + x + 4)/x² dx = ?",
      "choices": {
        "A": "x²/2 + ln|x| − 4/x + C",
        "B": "−x + log x − 8x + C",
        "C": "x⁻² + ln|x| − x²/2 + C",
        "D": "x²/2 + ln|x| + 4(−1/x) + C"
      },
      "correct_answer": "A",
      "explanation": "= ∫x dx + ∫(1/x)dx + 4∫x⁻² dx = x²/2 + ln|x| − 4/x + C",
      "reference": "FE Reference Handbook, Mathematics"
    },
    {
      "id": "MATH-CALC-EXTRA-7",
      "subtopic": "Calculus",
      "difficulty": "medium",
      "stem": "Which is NOT a correct derivative?",
      "choices": {
        "A": "d/dx(cos x) = −sin x",
        "B": "d/dx(1−x)³ = −3(1−x)²",
        "C": "d/dx(1/x) = −1/x²",
        "D": "d/dx(csc x) = −cot x"
      },
      "correct_answer": "D",
      "explanation": "d/dx(csc x) = −csc x·cot x ≠ −cot x. Option D is incorrect.",
      "reference": "FE Reference Handbook, Mathematics"
    },
    {
