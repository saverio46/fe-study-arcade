    {
      "id": "MATH-D8-Q1",
      "subtopic": "Ordinary differential equations",
      "difficulty": "medium",
      "stem": "Solve the initial value problem dy/dx = 2x, with y(0) = 5. What is the value of y(2)?",
      "choices": {
        "A": "7",
        "B": "8",
        "C": "9",
        "D": "10"
      },
      "correct_answer": "C",
      "explanation": "Integrating both sides yields y(x) = x^2 + C. Using y(0) = 5, we get C = 5. Therefore y(x) = x^2 + 5. Evaluating at x = 2 gives y(2) = 2^2 + 5 = 9.",
      "reference": "FE Reference Handbook, Mathematics: Ordinary Differential Equations"
    },
    {
      "id": "MATH-D8-Q2",
      "subtopic": "Ordinary differential equations",
      "difficulty": "medium",
      "stem": "What is the value of the Laplace transform L{e^(2t)} evaluated at s = 3?",
      "choices": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "5"
      },
      "correct_answer": "A",
      "explanation": "The Laplace transform of e^(at) is 1/(s - a). Here, a = 2, so L{e^(2t)} = 1/(s - 2). Evaluated at s = 3, this is 1/(3 - 2) = 1.",
      "reference": "FE Reference Handbook, Mathematics: Ordinary Differential Equations (Laplace Transforms)"
    },
    {
      "id": "MATH-D8-Q3",
      "subtopic": "Ordinary differential equations",
      "difficulty": "medium",
      "stem": "For the second-order homogeneous linear ODE y'' - 5y' + 6y = 0, what is the sum of the roots of its characteristic equation?",
      "choices": {
        "A": "1",
        "B": "5",
        "C": "6",
        "D": "-5"
      },
      "correct_answer": "B",
      "explanation": "The characteristic equation is r^2 - 5r + 6 = 0, which factors to (r - 2)(r - 3) = 0. The roots are 2 and 3, and their sum is 5.",
      "reference": "FE Reference Handbook, Mathematics: Ordinary Differential Equations"
    },
    {
      "id": "MATH-D8-Q4",
      "subtopic": "Ordinary differential equations",
      "difficulty": "easy",
      "stem": "For the differential equation dy/dt + 3y = 0 with initial condition y(0) = 4, what is the coefficient of the exponential term in the solution?",
      "choices": {
        "A": "3",
        "B": "4",
        "C": "-3",
        "D": "7"
      },
      "correct_answer": "B",
      "explanation": "This is a separable first-order ODE. The solution has the form y(t) = C*e^(-3t). The initial condition y(0) = 4 yields C = 4. The coefficient is 4.",
      "reference": "FE Reference Handbook, Mathematics: Ordinary Differential Equations"
    },
    {
      "id": "MATH-D8-Q5",
      "subtopic": "Ordinary differential equations",
      "difficulty": "easy",
      "stem": "What is the order of the differential equation d^3y/dx^3 + 4(dy/dx)^5 = 0?",
      "choices": {
        "A": "1",
        "B": "3",
        "C": "4",
        "D": "5"
      },
      "correct_answer": "B",
      "explanation": "The order of a differential equation is the order of the highest derivative present in the equation. In this case, the highest derivative is the third derivative, making the order 3.",
      "reference": "FE Reference Handbook, Mathematics: Ordinary Differential Equations"
    },
