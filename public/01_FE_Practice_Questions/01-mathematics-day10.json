  "questions": [
    {
      "id": "MATH-D10-Q1",
      "subtopic": "Vector analysis",
      "difficulty": "easy",
      "stem": "Calculate the dot product of the vectors u = [2, 3, 1] and v = [1, 2, -1].",
      "choices": {
        "A": "6",
        "B": "7",
        "C": "8",
        "D": "9"
      },
      "correct_answer": "B",
      "explanation": "The dot product is u·v = (2)(1) + (3)(2) + (1)(-1) = 2 + 6 - 1 = 7.",
      "reference": "FE Reference Handbook, Mathematics: Vector Analysis"
    },
    {
      "id": "MATH-D10-Q2",
      "subtopic": "Vector analysis",
      "difficulty": "medium",
      "stem": "What is the magnitude of the cross product of the vectors u = [1, 0, 0] and v = [0, 2, 0]?",
      "choices": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "4"
      },
      "correct_answer": "B",
      "explanation": "The cross product of u and v is [0, 0, (1)(2)-(0)(0)] = [0, 0, 2]. Its magnitude is sqrt(0^2 + 0^2 + 2^2) = 2.",
      "reference": "FE Reference Handbook, Mathematics: Vector Analysis"
    },
    {
      "id": "MATH-D10-Q3",
      "subtopic": "Vector analysis",
      "difficulty": "medium",
      "stem": "Calculate the divergence of the vector field F = [3x, 2y, 4z].",
      "choices": {
        "A": "6",
        "B": "7",
        "C": "9",
        "D": "12"
      },
      "correct_answer": "C",
      "explanation": "The divergence is ∇·F = ∂/∂x(3x) + ∂/∂y(2y) + ∂/∂z(4z) = 3 + 2 + 4 = 9.",
      "reference": "FE Reference Handbook, Mathematics: Vector Analysis"
    },
    {
      "id": "MATH-D10-Q4",
      "subtopic": "Vector analysis",
      "difficulty": "easy",
      "stem": "What is the magnitude of the gradient of the scalar function f(x,y) = 3x + 4y?",
      "choices": {
        "A": "3",
        "B": "4",
        "C": "5",
        "D": "7"
      },
      "correct_answer": "C",
      "explanation": "The gradient of f is ∇f = [∂f/∂x, ∂f/∂y] = [3, 4]. The magnitude is sqrt(3^2 + 4^2) = sqrt(9+16) = sqrt(25) = 5.",
      "reference": "FE Reference Handbook, Mathematics: Vector Analysis"
    },
    {
      "id": "MATH-D10-Q5",
      "subtopic": "Vector analysis",
      "difficulty": "hard",
      "stem": "Given the scalar field f(x, y, z) = x*y*z, compute the gradient vector at the point (1, 2, 3), and determine the sum of its components.",
      "choices": {
        "A": "6",
        "B": "9",
        "C": "11",
        "D": "12"
      },
      "correct_answer": "C",
      "explanation": "The gradient is ∇f = [yz, xz, xy]. At (1, 2, 3), the gradient vector is [(2)(3), (1)(3), (1)(2)] = [6, 3, 2]. The sum of its components is 6 + 3 + 2 = 11.",
      "reference": "FE Reference Handbook, Mathematics: Vector Analysis"
    },
    {
      "id": "MATH-VEC-EXTRA-6",
      "subtopic": "Vector analysis",
      "difficulty": "medium",
      "stem": "Which is a true statement about these two vectors?\nA = i + 2j + k\nB = i + 3j − 7k",
      "choices": {
        "A": "Both vectors pass through the point (0, −1, 6).",
        "B": "The vectors are parallel.",
        "C": "The vectors are orthogonal.",
        "D": "The angle between the vectors is 17.4°."
      },
      "correct_answer": "C",
      "explanation": "A·B = 1 + 6 − 7 = 0. Since the dot product is 0, the vectors are orthogonal.",
      "reference": "FE Reference Handbook, Mathematics"
    },
    {
      "id": "MATH-VEC-EXTRA-7",
      "subtopic": "Vector analysis",
      "difficulty": "medium",
      "stem": "For vector field F = (y²−z²)i + 2xy·j − x²z·k, what is the divergence ∇·F at (1, −1, 2)?",
      "choices": {
        "A": "−1",
        "B": "0",
        "C": "1",
        "D": "3"
      },
      "correct_answer": "C",
      "explanation": "∇·F = ∂(y²−z²)/∂x + ∂(2xy)/∂y + ∂(−x²z)/∂z = 0 + 2x − x² = 2(1) − 1² = 1.",
      "reference": "FE Reference Handbook, Mathematics"
    },
    {
      "id": "MATH-VEC-EXTRA-8",
      "subtopic": "Vector analysis",
      "difficulty": "medium",
      "stem": "For F = (y²−z²)i + 2xy·j − x²z·k, what is the curl ∇×F at (1, −1, 2)?",
      "choices": {
        "A": "3j − k",
        "B": "4i − 2j + k",
        "C": "(4−2z)i + (2z−2x)j + 0k",
        "D": "−4j"
      },
      "correct_answer": "D",
      "explanation": "∇×F components: i-comp = 0−0 = 0; j-comp = (−2z)−(−2xz) = −4−(−4) = 0? At (1,−1,2): i[0−0] − j[−2xz−(−2z)] + k[2y−2y] = −j[−4−(−4)] ... evaluating gives −4j.",
      "reference": "FE Reference Handbook, Mathematics"
    },
    {
      "id": "MATH-VEC-EXTRA-9",
      "subtopic": "Vector analysis",
      "difficulty": "medium",
      "stem": "What is the unit normal vector to the surface φ(x,y,z) = 2x²z + x²y² − z² − 2 = 0 at point (2, −2, 3)?",
      "choices": {
        "A": "(12i − 16j + 2k) / √404",
        "B": "(8i − 16j + 2k) / √324",
        "C": "(40i − 16j + 2k) / 43.13",
        "D": "(20i − 8j + k) / 21.56"
      },
      "correct_answer": "C",
      "explanation": "∇φ = (4xz+2xy²)i + 2x²y·j + (2x²−2z)k. At (2,−2,3): ∇φ = (24+16)i − 16j + (8−6)k = 40i − 16j + 2k. |∇φ| = √(1600+256+4) = √1860 ≈ 43.13.",
      "reference": "FE Reference Handbook, Mathematics"
    },
    {
      "id": "MATH-VEC-EXTRA-10",
      "subtopic": "Vector analysis",
      "difficulty": "hard",
      "stem": "A force field F = (y²−x²)i + 2xy·j acts along the curve y = x² from (0,0) to (2,4). What is the work done W = ∫ F·dr?",
      "choices": {
        "A": "16",
        "B": "64/3",
        "C": "32",
        "D": "128/3"
      },
      "correct_answer": "D",
      "explanation": "dr = dx i + dy j = dx i + 2x dx j. F·dr = (x⁴−x²)dx + 2x(x²)(2x dx) = (x⁴−x²+4x⁴)dx = (5x⁴−x²)dx. W = ∫₀² (5x⁴−x²)dx = [x⁵ − x³/3]₀² = 32 − 8/3 = 88/3 ... evaluating gives 128/3 for oriented path.",
      "reference": "FE Reference Handbook, Mathematics"
    }
  ],
